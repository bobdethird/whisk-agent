<mujoco model="three_cup_stack_scene">
    <!-- Three identical cups as separate bodies (stacked). Tag ID 8 on the BOTTOM cup only.
         Fixed placement_pad with tag ID 9: same X as the tower, offset in Y (beside, not +x past the stack). -->
    <include file="so101.xml" />

    <visual>
        <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0" />
        <rgba haze="0.15 0.25 0.35 1" />
        <global azimuth="160" elevation="-20" offwidth="2560" offheight="1920" />
    </visual>

    <asset>
        <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072" />
        <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.18 0.19 0.20" rgb2="0.12 0.13 0.14" markrgb="0.35 0.35 0.35" width="300" height="300" />
        <texture type="2d" name="work_table_top_texture" builtin="checker" mark="edge" rgb1="0.50 0.32 0.18" rgb2="0.42 0.26 0.14" markrgb="0.62 0.45 0.28" width="512" height="512" />
        <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.04" specular="0.05" shininess="0.05" />
        <material name="work_table_top_material" texture="work_table_top_texture" rgba="0.55 0.36 0.2 1" texuniform="true" texrepeat="3 2" reflectance="0" specular="0.08" shininess="0.08" />
        <material name="work_table_leg_material" rgba="0.36 0.22 0.12 1" reflectance="0" specular="0.05" shininess="0.05" />
        <material name="cup_material" rgba="0.85 0.92 1.0 0.65" specular="0.2" shininess="0.25" />
        <material name="cup_handle_material" rgba="0.85 0.92 1.0 0.85" specular="0.2" shininess="0.25" />
        <mesh name="stack_tag36h11_00008_mesh" file="apriltags/tag_card.obj" scale="0.03 0.03 0.002" />
        <texture type="2d" name="stack_tag36h11_00008_texture" file="assets/apriltags/tag36_11_00008.png" />
        <material name="stack_tag36h11_00008" texture="stack_tag36h11_00008_texture" rgba="1 1 1 1" texuniform="true" texrepeat="1 1" emission="0.5" specular="0" shininess="0" reflectance="0" />
        <texture type="2d" name="placement_tag36h11_00009_texture" file="assets/apriltags/tag36_11_00009.png" />
        <material name="placement_tag36h11_00009" texture="placement_tag36h11_00009_texture" rgba="1 1 1 1" texuniform="true" texrepeat="1 1" emission="0.5" specular="0" shininess="0" reflectance="0" />
    </asset>

    <!-- Cup centers spaced by 2 * half_height (0.045) * 2 = 0.09 m when rims touch. -->
    <worldbody>
        <light pos="0 0 3.5" dir="0 0 -1" directional="true" />
        <light pos="0.15 -0.45 0.75" dir="0.1 0.35 -1" directional="true" diffuse="0.45 0.4 0.35" />
        <geom name="floor" size="0 0 0.05" pos="0 0 -0.45" type="plane" material="groundplane" />

        <body name="work_table">
            <geom name="work_table_top" type="box" pos="0.22 0 -0.025" size="0.36 0.26 0.025" material="work_table_top_material" friction="1.3 0.01 0.001" />
            <geom name="work_table_leg_0" type="box" pos="-0.095 -0.215 -0.25" size="0.018 0.018 0.2" material="work_table_leg_material" friction="1.0 0.01 0.001" />
            <geom name="work_table_leg_1" type="box" pos="-0.095 0.215 -0.25" size="0.018 0.018 0.2" material="work_table_leg_material" friction="1.0 0.01 0.001" />
            <geom name="work_table_leg_2" type="box" pos="0.535 -0.215 -0.25" size="0.018 0.018 0.2" material="work_table_leg_material" friction="1.0 0.01 0.001" />
            <geom name="work_table_leg_3" type="box" pos="0.535 0.215 -0.25" size="0.018 0.018 0.2" material="work_table_leg_material" friction="1.0 0.01 0.001" />
        </body>

        <!-- Fixed placement pad: tag ID 9. Beside the tower (offset in Y) so the arm sidesteps instead of reaching deeper +x toward table legs / edge. -->
        <body name="placement_pad" pos="0.32 -0.17 0.003">
            <geom name="placement_pad_top" type="box" pos="0 0 0" size="0.07 0.07 0.003" material="work_table_top_material" friction="1.3 0.01 0.001" />
            <body name="placement_tag36h11_00009" pos="-0.026 0 0.067" quat="0.7071067812 0 -0.7071067812 0">
                <geom name="placement_tag36h11_00009_visual" type="mesh" mesh="stack_tag36h11_00008_mesh" material="placement_tag36h11_00009" contype="0" conaffinity="0" density="0" />
                <site name="placement_tag36h11_00009_site" pos="0 0 0" size="0.005" rgba="0 1 0 0" />
            </body>
        </body>

        <!-- Bottom cup: center z = 0.045 (unchanged convention). Tag on -x face (same as single-cup tag 6). -->
        <body name="cup_bottom" pos="0.32 0 0.045">
            <freejoint name="cup_bottom_freejoint" />
            <geom name="stack_bottom_side" type="cylinder" size="0.023 0.045" mass="0.025" condim="6" friction="1.0 0.02 0.002" solref="0.01 1" rgba="0.55 0.75 1.0 0.35" />
            <geom name="stack_bottom_visual" type="cylinder" size="0.0235 0.0455" material="cup_material" contype="0" conaffinity="0" density="0" />
            <geom name="stack_bottom_handle_collision" type="capsule" fromto="0.0 0.060 -0.020 0.0 0.060 0.045" size="0.005" density="0" condim="6" friction="1.0 0.02 0.002" solref="0.01 1" rgba="0.55 0.75 1.0 0.35" />
            <geom name="stack_bottom_handle_visual" type="capsule" fromto="0.0 0.060 -0.020 0.0 0.060 0.045" size="0.005" material="cup_handle_material" contype="0" conaffinity="0" density="0" />
            <body name="stack_tag36h11_00008" pos="-0.026 0 0.067" quat="0.7071067812 0 -0.7071067812 0">
                <geom name="stack_tag36h11_00008_visual" type="mesh" mesh="stack_tag36h11_00008_mesh" material="stack_tag36h11_00008" contype="0" conaffinity="0" density="0" />
                <site name="stack_tag36h11_00008_site" pos="0 0 0" size="0.005" rgba="0 1 0 0" />
            </body>
        </body>

        <!-- Middle cup -->
        <body name="cup_mid" pos="0.32 0 0.135">
            <freejoint name="cup_mid_freejoint" />
            <geom name="stack_mid_side" type="cylinder" size="0.023 0.045" mass="0.025" condim="6" friction="1.0 0.02 0.002" solref="0.01 1" rgba="0.55 0.75 1.0 0.35" />
            <geom name="stack_mid_visual" type="cylinder" size="0.0235 0.0455" material="cup_material" contype="0" conaffinity="0" density="0" />
            <geom name="stack_mid_handle_collision" type="capsule" fromto="0.0 0.060 -0.020 0.0 0.060 0.045" size="0.005" density="0" condim="6" friction="1.0 0.02 0.002" solref="0.01 1" rgba="0.55 0.75 1.0 0.35" />
            <geom name="stack_mid_handle_visual" type="capsule" fromto="0.0 0.060 -0.020 0.0 0.060 0.045" size="0.005" material="cup_handle_material" contype="0" conaffinity="0" density="0" />
        </body>

        <!-- Top cup -->
        <body name="cup_top" pos="0.32 0 0.225">
            <freejoint name="cup_top_freejoint" />
            <geom name="stack_top_side" type="cylinder" size="0.023 0.045" mass="0.025" condim="6" friction="1.0 0.02 0.002" solref="0.01 1" rgba="0.55 0.75 1.0 0.35" />
            <geom name="stack_top_visual" type="cylinder" size="0.0235 0.0455" material="cup_material" contype="0" conaffinity="0" density="0" />
            <geom name="stack_top_handle_collision" type="capsule" fromto="0.0 0.060 -0.020 0.0 0.060 0.045" size="0.005" density="0" condim="6" friction="1.0 0.02 0.002" solref="0.01 1" rgba="0.55 0.75 1.0 0.35" />
            <geom name="stack_top_handle_visual" type="capsule" fromto="0.0 0.060 -0.020 0.0 0.060 0.045" size="0.005" material="cup_handle_material" contype="0" conaffinity="0" density="0" />
        </body>

        <camera name="cup_observer" pos="0.25 -0.35 0.35" xyaxes="1 0 0 0 0.55 0.4" fovy="55" />
        <camera name="table_observer" pos="0.08 -0.28 0.18" xyaxes="0.7945188897 -0.6072394371 0 0.1150475128 0.1505294561 0.9818884624" fovy="60" />
    </worldbody>
</mujoco>
